# Auto-detect text files and normalize line endings to LF in the repository
* text=auto eol=lf

# Shell scripts and Gradle wrapper (Unix) must use LF
*.sh text eol=lf
gradlew text eol=lf

# Windows batch scripts must use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.keystore binary
*.jks binary
